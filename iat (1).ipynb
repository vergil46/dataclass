    " import pandas as pd\n",
    " import numpy as np\n",
    " import matplotlib.pyplot as plt\n",
    " def load_survey_data(csv_file):\n",
    "    try:\n",
    "        # Read CSV file into a DataFrame\n",
    "        df = pd.read_csv('sampledata_pandas - Table 1.csv')\n",
    "        return df\n",
    "    except Exception as e:\n",
    "        print(\"Error reading CSV file:\", e)\n",
    "        return None\n",
    " def process_data(df):\n",
    "    # Rename the columns for easier access\n",
    "    df.columns = ['Timestamp', 'Name', 'RegNo', 'ProgrammingBackground', 'FamiliarWithPandas', 'ProgrammingLevel']\n",
    "    df.columns = [col.strip() for col in df.columns]\n",
    "    # Remove the entry where Name equals \"Gokul\"\n",
    "    df = df[df['Name'] != 'Gokul']\n",
    "    df['ProgrammingLevel'] = df['ProgrammingLevel'].astype(int)\n",
    "    # Convert the Timestamp column to a datetime object.\n",
    "    try:\n",
    "        df['Timestamp'] = pd.to_datetime(df['Timestamp'], format='%Y/%m/%d %I:%M:%S %p GMT+5:30')\n",
    "    except Exception as e:\n",
    "        print(\"Error converting Timestamp column:\", e)\n",
    "        return None\n",
    "    base_time = pd.Timestamp('2022-12-12 09:00:00')\n",
    "    df['TimeDelta'] = (df['Timestamp'] - base_time).dt.total_seconds() / 60\n",
    "    bins = [-np.inf, 10, 15, 20, 30, 35, np.inf]\n",
    "    marks = [5, 4, 3, 2, 1, 0]\n",
    "    df['Marks'] = pd.cut(df['TimeDelta'], bins=bins, labels=marks).astype(int)\n",
    "    # Explore statistics of the ProgrammingLevel column\n",
    "    mean_level = df['ProgrammingLevel'].mean()\n",
    "    median_level = df['ProgrammingLevel'].median()\n",
    "    mode_level = df['ProgrammingLevel'].mode()[0]\n",
    "    print(\"Programming Level Statistics:\")\n",
    "    print(f\"Mean: {mean_level:.2f}, Median: {median_level}, Mode: {mode_level}\")\n",
    "    print(\"\\nDetails of ProgrammingLevel:\")\n",
    "    print(df['ProgrammingLevel'].describe())\n",
    "    # Create a new column 'Programming' based on the ProgrammingLevel.\n",
    "    def categorize(level):\n",
    "        if level == 1:\n",
    "            return 'Low'\n",
    "        elif 2 <= level <= 3:\n",
    "            return 'Medium'\n",
    "        elif level in (4, 5):\n",
    "            return 'Good'\n",
    "        else:\n",
    "            return 'Unknown'\n",
    "    df['Programming'] = df['ProgrammingLevel'].apply(categorize)\n",
    "    # Generate basic plots\n",
    "    # Plot 1: Bar plot for Marks Distribution\n",
    "    plt.figure(figsize=(6,4))\n",
    "    df['Marks'].value_counts().sort_index().plot(kind='bar', color='skyblue', edgecolor='black')\n",
    "    plt.title('Marks Distribution')\n",
    "    plt.xlabel('Marks')\n",
    "    plt.ylabel('Frequency')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    # Plot 2: Histogram for Programming Level\n",
    "    plt.figure(figsize=(6,4))\n",
    "    df['ProgrammingLevel'].plot(kind='hist', bins=5, range=(1,5), rwidth=0.8, color='orange', edgecolor='black')\n",
    "    plt.title('Programming Level Distribution')\n",
    "    plt.xlabel('Programming Level')\n",
    "    plt.ylabel('Frequency')\n",
    "    plt.xticks([1,2,3,4,5])\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    # Plot 3: Pie chart for Programming Proficiency\n",
    "    plt.figure(figsize=(6,6))\n",
    "    df['Programming'].value_counts().plot(kind='pie', autopct='%1.1f%%', startangle=90)\n",
    "    plt.title('Programming Proficiency')\n",
    "    plt.ylabel('')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    return df\n",
    " def main():\n",
    "    csv_file = \"E:\\\\python_project\\\\survey.csv\"\n",
    "    df = load_survey_data(csv_file)\n",
    "    if df is None:\n",
    "        print(\"Failed to load survey data. Please check the CSV file and try again.\")\n",
    "        return\n",
    "    processed_df = process_data(df)\n",
    "    if processed_df is not None:\n",
    "        try:\n",
    "            processed_df.to_csv('processed_survey.csv', index=False)\n",
    "            print(\"Processing complete. The processed data has been saved as 'processed_survey.csv'.\")\n",
    "        except Exception as e:\n",
    "            print(\"Error saving the processed CSV file:\", e)\n",
    " if __name__ == \"__main__\":\n",
    "    main()"
   ]
